package features {
    package UpdateUserInformation {
        package UpdateUserInformationMain {
            package database {
                class UserInformationUpdateOnPostgreSQLDatabase implements UpdateUserInformationGateway {
                    - PostgreSQLDatabase postgreSQLDatabase
                    + constructor()
                    + UserInformationUpdateOutput updateUserInformation(UserInformationUpdateInput userInformationUpdateInput)
                    + string getUserRole(string userId)
                    + void connect()
                    + void close()
                    + any query()
                }
            }

            package router {
                class UpdateUserInformationRouter {
                    // register "post" route to retrieve chosen user
                }
            }

            package validation {
                class UpdateUserInformationInputJoiValidation implements UserInformationUpdateInputValidator {
                    - Joi joiValidationLibrary
                    + constructor()
                    + boolean userIdIsValid(string userId)
                    + boolean firstNameHasLettersOnly(string firstName)
                    + boolean lastNameHasLettersOnly(string lastName)
                }

                class UpdateUserInformationTypeValidator implements UpdateUserInformationTypeValidation {
                    - TypeValidator typeValidator
                    + bool isString(testedVariable: any, variableName: string)
                }
            }
        }

        package UpdateUserInformationController {
            class UpdateUserInformationController implements UpdateUserInformationInput {
                + UpdateUserInformationResponse handleUpdateUserInformationRequest(UpdateUserInformationRequest updateUserInformationRequest, UpdateUserInformationGateway retrieveUserGateway, UserInformationUpdateInputValidator userInformationUpdateInputValidator)
                + UpdateUserInformationOutput updateUserInformation(UserInformationUpdateInput userInformationUpdateInput, UpdateUserInformationGateway updateUserInformationGateway)
            }

            class UpdateUserInformationRequest {
                - string userId
                - string udpatedUserId
                - string firstName
                - string lastName
                - UpdateUserInformationTypeValidation updateUserInformationTypeValidation
                + constructor(UpdateUserInformationTypeValidation updateUserInformationTypeValidation)
                + string getUserId()
                + self setUserId(string userId)
                + string getUpdatedUserId()
                + self setUpdatedUserId(string updatedUserId)
                + string getFirstName()
                + self setFirstName(string firstName)
                + string getLastName()
                + self setLastName(string lastName)
            }

            interface UpdateUserInformationTypeValidation {
                + bool isString(testedVariable: any, variableName: string)
            }

            class UpdateUserInformationPresenter implements UpdateUserInformationOutput {
                - UpdateUserInformationResponse updateUserInformationResponse
                + UpdateUserInformationResponse getUpdateUserInformationResponse()
                + void retrieveUserInformationUpdateOutput(UserInformationUpdateOutput userInformationUpdateOutput)
            }

            class UpdateUserInformationResponse {
                - boolean _userInformationWereUpdated 
                + boolean userInformationWereUpdated()
                + self setWetherTheUserInformationWereUpdated(boolean userInformationWereUpdated)
            }
        }

        package UpdateUserInformationUseCase {
            class UpdateUserInformationUseCase {
                + UpdateUserInformationOutput updateUserInformation(UserInformationUpdateInput userInformationUpdateInput, UpdateUserInformationGateway updateUserInformationGateway)
            }

            interface UpdateUserInformationInput {
                + UpdateUserInformationOutput updateUserInformation(UserInformationUpdateInput userInformationUpdateInput, UpdateUserInformationGateway updateUserInformationGateway)
            }

            class UserInformationUpdateInput {
                - string userId
                - string udpatedUserId
                - string firstName
                - string lastName
                - UserInformationUpdateInputValidator userInformationUpdateInputValidator
                + constructor(UserInformationUpdateInputValidator userInformationUpdateInputValidator)
                + string getUserId()
                + self setUserId(string userId)
                + string getUpdatedUserId()
                + self setUpdatedUserId(string updatedUserId)
                + string getFirstName()
                + self setFirstName(string firstName)
                + string getLastName()
                + self setLastName(string lastName)
            }

            interface UpdateUserInformationGateway {
                + UserInformationUpdateOutput updateUserInformation(UserInformationUpdateInput userInformationUpdateInput)
                + string getUserRole(string userId)
            }

            class UserInformationUpdateOutput {
                - boolean _userInformationWereUpdated 
                + boolean userInformationWereUpdated()
                + self setWetherTheUserInformationWereUpdated(boolean userInformationWereUpdated)
            }

            interface UpdateUserInformationOutput {
                + void retrieveUserInformationUpdateOutput(UserInformationUpdateOutput userInformationUpdateOutput)
            }

            interface UserInformationUpdateInputValidator {
                + boolean userIdIsValid(string userId)
                + boolean firstNameHasLettersOnly(string firstName)
                + boolean lastNameHasLettersOnly(string lastName)
            }
        }

        package tests {
            // retrieveUserTests.ts file
        }
    }
}